if (WIN32)
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU")
        if(CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 15.0)
            add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-Wno-template-body>) # Workaround for WinRT headers
        endif()
    endif()
elseif (APPLE)
elseif (UNIX)
    include(GNUInstallDirs)

    if(NOT DEFINED TUNASTREAM_EXECUTABLE_PATH)
        set(TUNASTREAM_EXECUTABLE_PATH "tunastream")
    endif()

    if(TUNASTREAM_BUILD_FLATPAK)
        set(TUNASTREAM_SERVICE_START_COMMAND "ExecStart=flatpak run --command=tunastream ${PROJECT_FQDN}")
        set(TUNASTREAM_SERVICE_STOP_COMMAND "ExecStop=flatpak kill ${PROJECT_FQDN}")
    else()
        set(TUNASTREAM_SERVICE_START_COMMAND "ExecStart=${TUNASTREAM_EXECUTABLE_PATH}")
        set(TUNASTREAM_SERVICE_STOP_COMMAND "")
    endif()
endif()
